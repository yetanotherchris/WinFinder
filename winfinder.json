{
  "homepage": "https://github.com/yetanotherchris/WinFinder",
  "description": "A macOS Finder-inspired desktop file manager for Windows built with Tauri v2.",
  "version": "0.0.5",
  "license": "MIT",
  "shortcuts": [
    [
      "winfinder.exe",
      "WinFinder"
    ]
  ],
  "architecture": {
    "64bit": {
      "url": "https://github.com/yetanotherchris/WinFinder/releases/download/v0.0.5/winfinder-0.0.5-windows-x64.zip",
      "hash": "f381be082b8c7f5f8a920589775ba96292f4c5278b1ba0952b18a481e12ec60a",
      "bin": [
        [
          "winfinder.exe",
          "winfinder"
        ]
      ]
    }
  },
  "post_uninstall": [
    "if ($cmd -eq 'uninstall') {",
    "    $configDir = Join-Path $env:USERPROFILE '.winfinder'",
    "    $configFile = Join-Path $configDir 'config.json'",
    "    if (Test-Path -LiteralPath $configFile) {",
    "        Remove-Item -LiteralPath $configFile -Force -ErrorAction SilentlyContinue",
    "    }",
    "    if ((Test-Path -LiteralPath $configDir -PathType Container) -and -not (Get-ChildItem -LiteralPath $configDir -Force -ErrorAction SilentlyContinue)) {",
    "        Remove-Item -LiteralPath $configDir -Force -ErrorAction SilentlyContinue",
    "    }",
    "}"
  ]
}
