{
  "homepage": "https://github.com/yetanotherchris/WinFinder",
  "description": "A macOS Finder-inspired desktop file manager for Windows built with Tauri v2.",
  "version": "1.2.0",
  "license": "MIT",
  "shortcuts": [
    [
      "winfinder.exe",
      "WinFinder"
    ]
  ],
  "architecture": {
    "64bit": {
      "url": "https://github.com/yetanotherchris/WinFinder/releases/download/v1.2.0/winfinder-1.2.0-windows-x64.zip",
      "hash": "bdb1e016133d85b415b76f3f7b2707249e8d13153a7fdfffc6e4ee68eb0e5609",
      "bin": [
        [
          "winfinder.exe",
          "winfinder"
        ]
      ]
    }
  },
  "post_uninstall": [
    "if ($cmd -eq 'uninstall') {",
    "    $configDir = Join-Path $env:USERPROFILE '.winfinder'",
    "    foreach ($fileName in @('config.json', 'app-icon-beige.ico')) {",
    "        $targetFile = Join-Path $configDir $fileName",
    "        if (Test-Path -LiteralPath $targetFile) {",
    "            Remove-Item -LiteralPath $targetFile -Force -ErrorAction SilentlyContinue",
    "        }",
    "    }",
    "    if ((Test-Path -LiteralPath $configDir -PathType Container) -and -not (Get-ChildItem -LiteralPath $configDir -Force -ErrorAction SilentlyContinue)) {",
    "        Remove-Item -LiteralPath $configDir -Force -ErrorAction SilentlyContinue",
    "    }",
    "}"
  ]
}
